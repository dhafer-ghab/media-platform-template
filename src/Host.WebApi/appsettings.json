{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "PostgreConnectionString": "Host=localhost;Port=5432;Database=MainDb;Username=postgres;Password=password"
  },

  "Jwt": {
    "Issuer": "[from_key_vault_or_env_var]",
    "Audience": "[from_key_vault_or_env_var]",
    "SecretKey": "[from_key_vault_or_env_var]",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownProxies": []
  }
}
