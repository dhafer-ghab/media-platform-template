---
export const prerender = false;

import { catalogApi } from '@/api/catalog';
import AlbumCard from '@/components/media/AlbumCard.astro';
import Pagination from '@/components/media/Pagination.astro';
import MediaLayout from '@/layouts/MediaLayout.astro';
import { applyCatalogCache, pageParam, redirectPastLastPage } from '@/lib/http';
import { explorePath } from '@/lib/routes';

const page = pageParam(Astro.url);
if (page === null) return new Response('Invalid page.', { status: 400 });
const q = Astro.url.searchParams.get('q')?.trim() || undefined;
const tag = Astro.url.searchParams.get('tag')?.trim() || undefined;
const result = await catalogApi.discovery({ q, tag, page, pageSize: 24 }, { signal: Astro.request.signal });
const pageRedirect = redirectPastLastPage(page, result.totalPages, (lastPage) => explorePath({ q, tag, page: lastPage }));
if (pageRedirect) return pageRedirect;
applyCatalogCache(Astro.response);

const path = explorePath({ q, tag, page: result.page });
const heading = q ? `Results for “${q}”` : tag ? tag : 'Explore';
const title = result.page > 1 ? `${heading}, page ${result.page}` : heading;
const description = q
  ? `Search the Verso catalog for ${q}. Browse matching albums and creators from the authoritative media catalog.`
  : tag
    ? `Explore albums tagged ${tag} in the Verso catalog, with photography, video, and work from contemporary creators.`
    : 'Explore the Verso catalog of contemporary creators, photography, video, albums, and visual stories from around the world.';
---

<MediaLayout title={title} description={description} path={path} initialQ={q} noindex={Boolean(q) || result.items.length === 0}
  prevPath={result.hasPrev ? explorePath({ q, tag, page: result.page - 1 }) : null}
  nextPath={result.hasNext ? explorePath({ q, tag, page: result.page + 1 }) : null}>
  <main class="container explore">
    <header>
      <p class="eyebrow">Catalog</p>
      <h1>{heading}</h1>
      <p>{result.totalItems} {result.totalItems === 1 ? 'album' : 'albums'}</p>
    </header>
    <form class="filters" action={explorePath()} method="get" role="search">
      <label for="catalog-q">Search catalog</label>
      <div><input id="catalog-q" name="q" type="search" value={q} placeholder="Album, creator, or description" /><button>Search</button></div>
      {tag && <input type="hidden" name="tag" value={tag} />}
    </form>
    {result.items.length ? <div class="grid">{result.items.map((item, index) => <AlbumCard album={item} eager={page === 1 && index < 4} />)}</div> : <p class="empty">No albums matched this request.</p>}
    <Pagination page={result.page} totalPages={result.totalPages} hasPrev={result.hasPrev} hasNext={result.hasNext}
      hrefFor={(nextPage) => explorePath({ q, tag, page: nextPage })} label="Explore results" />
  </main>
</MediaLayout>

<style>
  .explore { padding-top: clamp(38px, 6vw, 76px); }
  .eyebrow { margin: 0; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 8px 0 0; font: 500 clamp(36px, 6vw, 72px)/1 var(--font-serif); }
  header > p:last-child { color: var(--muted); }
  .filters { max-width: 680px; margin: 32px 0; }
  .filters label { display: block; margin-bottom: 8px; font-size: 12px; font-weight: 600; }
  .filters div { display: flex; }
  .filters input { min-width: 0; flex: 1; padding: 13px; border: 1px solid var(--border); background: var(--bg); color: var(--text); }
  .filters button { padding: 0 22px; border: 1px solid var(--text); background: var(--text); color: var(--bg); font-weight: 700; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  .empty { padding: 42px; border: 1px dashed var(--border); color: var(--muted); text-align: center; }
</style>
