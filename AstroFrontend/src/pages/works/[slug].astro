---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import WorkCard from '@/components/ui/WorkCard.astro';
import { artworks, artists, categories } from '@/data/gallery';

export function getStaticPaths() {
  return artworks.map((w) => ({ params: { slug: w.slug } }));
}

const { slug } = Astro.params;
const work = artworks.find((w) => w.slug === slug);
if (!work) {
  return Astro.redirect('/');
}

const artist = artists[work.artistId]!;
const cat = categories.find((c) => c.name === work.category);
const related = artworks
  .filter((x) => x.id !== work.id && (x.category === work.category || x.tags.some((t) => work.tags.includes(t))))
  .slice(0, 4);
---

<Layout title={`${work.title} — ${work.artistName} — Verso`}>
  <main class="container page">
    <div class="crumbs">
      <a href="/">Index</a>
      <span class="crumb-sep">/</span>
      <a href={cat ? `/categories/${cat.slug}` : '/categories'}>{work.category}</a>
      <span class="crumb-sep">/</span>
      <span class="crumbs__current">{work.title}</span>
    </div>

    <div class="detail">
      <div class="detail__art" style={`background:${work.bg};aspect-ratio:${work.ar};`}></div>
      <div class="detail__side">
        <h1 class="detail__title">{work.title}</h1>
        <a class="detail__artist" href={`/artists/${artist.slug}`}>{work.artistName} →</a>
        <dl class="facts">
          <div class="fact"><span class="fact__k">Year</span><span>{work.year}</span></div>
          <div class="fact"><span class="fact__k">Medium</span><span class="fact__v">{work.medium}</span></div>
          <div class="fact"><span class="fact__k">Dimensions</span><span>{work.size}</span></div>
          <div class="fact">
            <span class="fact__k">Category</span>
            <a class="fact__link" href={cat ? `/categories/${cat.slug}` : '/categories'}>{work.category}</a>
          </div>
        </dl>
        <div class="detail__tags">
          {work.tags.map((t) => (
            <a class="tag-pill" href={`/tags/${encodeURIComponent(t.toLowerCase())}`}>{t}</a>
          ))}
        </div>
        <div class="detail__cta">
          <button class="btn btn-primary">Inquire</button>
          <button
            class="btn btn-ghost"
            data-save-toggle
            data-work-id={work.id}
            data-label-save="Save"
            data-label-saved="Saved ✓"
          >Save</button>
        </div>
      </div>
    </div>

    <section class="related">
      <h2 class="h-section related__h2">Related works</h2>
      <div class="related__grid">
        {related.map((w) => <WorkCard work={w} variant="compact" />)}
      </div>
    </section>
  </main>
</Layout>

<style>
  .page {
    padding: clamp(28px, 4vw, 52px) 0 0;
  }
  .crumbs {
    margin-bottom: 24px;
  }

  .detail {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }
  @media (min-width: 860px) {
    .detail {
      grid-template-columns: minmax(0, 1.32fr) minmax(280px, 0.9fr);
    }
  }
  .detail__art {
    width: 100%;
    max-height: 82vh;
    border: 1px solid var(--hairline);
  }
  .crumbs__current {
    color: var(--text-2);
  }
  .detail__side {
    position: sticky;
    top: 90px;
  }
  .detail__title {
    font-family: 'Spectral', serif;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(30px, 3.6vw, 46px);
    line-height: 1.08;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .detail__artist {
    display: inline-block;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 16px;
    transition: color 0.2s;
  }
  .detail__artist:hover {
    color: var(--text);
  }

  .facts {
    margin: 28px 0 0;
    border-top: 1px solid var(--border-soft);
  }
  .fact {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border-soft);
    font-size: 14px;
  }
  .fact__k {
    color: var(--muted);
  }
  .fact__v {
    text-align: right;
  }
  .fact__link {
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 22px;
  }
  .detail__cta {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .btn[data-saved='1'] {
    background: var(--surface);
    color: var(--text-2);
    border-color: var(--border);
  }

  .related {
    margin-top: clamp(48px, 7vw, 96px);
  }
  .related__h2 {
    font-size: clamp(22px, 2.6vw, 32px);
    margin: 0 0 26px;
    border-top: 1px solid var(--border-soft);
    padding-top: 30px;
  }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 28px;
  }
</style>
