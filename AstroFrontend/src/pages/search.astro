---
import Layout from '@/layouts/Layout.astro';
import { artworks, artists, artworksByArtist, galleryTags } from '@/data/gallery';

const searchIndex = {
  works: artworks.map((w) => ({
    title: w.title,
    artistName: w.artistName,
    year: w.year,
    bg: w.bg,
    ar: w.ar,
    slug: w.slug,
    haystack: `${w.title} ${w.artistName} ${w.medium} ${w.category} ${w.tags.join(' ')}`.toLowerCase(),
  })),
  artists: artists.map((a) => ({
    name: a.name,
    location: a.location,
    slug: a.slug,
    sample: artworksByArtist(a.id).slice(0, 3).map((w) => ({ bg: w.bg })),
    haystack: `${a.name} ${a.location} ${a.disciplines}`.toLowerCase(),
  })),
  tags: galleryTags.map((tag) => ({
    name: tag.name,
    slug: tag.slug,
    description: tag.description,
    count: tag.count,
    haystack: `${tag.name} ${tag.description}`.toLowerCase(),
  })),
};
---

<Layout title="Search — Verso" robots="noindex, follow">
  <main class="container page">
    <div class="eyebrow">Search</div>
    <h1 class="page__h1" data-search-h1>&ldquo;<span data-search-q></span>&rdquo;</h1>
    <p class="page__lede"><span data-search-count>0</span> <span data-search-noun>results</span></p>

    <p class="empty" data-search-empty hidden>
      Nothing found. Try a medium, an artist, or a tag like &ldquo;Minimal&rdquo;.
    </p>

    <p class="empty" data-search-prompt hidden>
      Type a query in the header search to find artists, works and tags.
    </p>

    <div class="section" data-search-tags-section hidden>
      <h2 class="section__h2">Tags</h2>
      <div class="tags-grid" data-search-tags></div>
    </div>

    <div class="section" data-search-artists-section hidden>
      <h2 class="section__h2">Artists</h2>
      <div class="artists-grid" data-search-artists></div>
    </div>

    <div class="section" data-search-works-section hidden>
      <h2 class="section__h2">Works</h2>
      <div class="masonry" data-search-works></div>
    </div>
  </main>

  <script type="application/json" data-search-index set:html={JSON.stringify(searchIndex)} />

  <script>
    type WorkRow = {
      title: string;
      artistName: string;
      year: number;
      bg: string;
      ar: number;
      slug: string;
      haystack: string;
    };
    type ArtistRow = {
      name: string;
      location: string;
      slug: string;
      sample: { bg: string }[];
      haystack: string;
    };
    type TagRow = {
      name: string;
      slug: string;
      description: string;
      count: number;
      haystack: string;
    };
    type Index = { works: WorkRow[]; artists: ArtistRow[]; tags: TagRow[] };

    const indexEl = document.querySelector<HTMLScriptElement>('[data-search-index]');
    if (!indexEl) throw new Error('search index missing');
    const idx = JSON.parse(indexEl.textContent ?? '{}') as Index;

    const $ = <T extends Element>(sel: string): T => {
      const el = document.querySelector<T>(sel);
      if (!el) throw new Error(`missing ${sel}`);
      return el;
    };

    const qSpan = $('[data-search-q]') as HTMLElement;
    const h1 = $('[data-search-h1]') as HTMLElement;
    const countEl = $('[data-search-count]') as HTMLElement;
    const nounEl = $('[data-search-noun]') as HTMLElement;
    const emptyEl = $('[data-search-empty]') as HTMLElement;
    const promptEl = $('[data-search-prompt]') as HTMLElement;
    const artistsSec = $('[data-search-artists-section]') as HTMLElement;
    const tagsSec = $('[data-search-tags-section]') as HTMLElement;
    const worksSec = $('[data-search-works-section]') as HTMLElement;
    const artistsHost = $('[data-search-artists]') as HTMLElement;
    const tagsHost = $('[data-search-tags]') as HTMLElement;
    const worksHost = $('[data-search-works]') as HTMLElement;

    const params = new URLSearchParams(window.location.search);
    const q = (params.get('q') ?? '').trim();
    const headerSearch = document.querySelector<HTMLInputElement>('[data-header-search]');
    if (headerSearch) headerSearch.value = q;

    if (!q) {
      h1.hidden = true;
      countEl.parentElement!.hidden = true;
      promptEl.hidden = false;
      document.title = 'Search — Verso';
    } else {
      qSpan.textContent = q;
      document.title = `“${q}” — Verso`;
      const qLower = q.toLowerCase();
      const works = idx.works.filter((w) => w.haystack.includes(qLower));
      const artists = idx.artists.filter((a) => a.haystack.includes(qLower));
      const tags = idx.tags.filter((tag) => tag.haystack.includes(qLower));
      const total = works.length + artists.length + tags.length;
      countEl.textContent = String(total);
      nounEl.textContent = total === 1 ? 'result' : 'results';

      if (total === 0) {
        emptyEl.hidden = false;
      }

      if (artists.length > 0) {
        artistsSec.hidden = false;
        artistsHost.innerHTML = artists
          .map((a) => {
            const cells = Array.from({ length: 3 })
              .map((_, i) => {
                const s = a.sample[i];
                const style = s ? `background:${s.bg};` : 'background:var(--surface);';
                return `<div class="artist-card__cell" style="${style}"></div>`;
              })
              .join('');
            return `
              <a class="artist-card" href="/artists/${a.slug}">
                <div class="artist-card__grid">${cells}</div>
                <div class="artist-card__name-only">${escapeHtml(a.name)}</div>
                <div class="artist-card__loc">${escapeHtml(a.location)}</div>
              </a>
            `;
          })
          .join('');
      }

      if (tags.length > 0) {
        tagsSec.hidden = false;
        tagsHost.innerHTML = tags
          .map(
            (tag) => `
              <a class="tag-result" href="/tags/${tag.slug}">
                <span class="tag-result__name">${escapeHtml(tag.name)}</span>
                <span class="tag-result__count">${tag.count} ${tag.count === 1 ? 'work' : 'works'}</span>
                <span class="tag-result__description">${escapeHtml(tag.description)}</span>
              </a>
            `,
          )
          .join('');
      }

      if (works.length > 0) {
        worksSec.hidden = false;
        worksHost.innerHTML = works
          .map(
            (w) => `
              <a class="work-card work-card--masonry" href="/works/${w.slug}">
                <div class="work-card__art" style="background:${w.bg};aspect-ratio:${w.ar};"></div>
                <div class="work-card__meta">
                  <div class="work-card__meta-l">
                    <div class="work-card__title">${escapeHtml(w.title)}</div>
                    <div class="work-card__sub">${escapeHtml(w.artistName)}</div>
                  </div>
                  <div class="work-card__year">${w.year}</div>
                </div>
              </a>
            `,
          )
          .join('');
      }
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
  </script>
</Layout>

<style>
  .page {
    padding: clamp(40px, 6vw, 80px) 0;
  }
  .page__h1 {
    font-family: 'Spectral', serif;
    font-weight: 300;
    font-style: italic;
    font-size: clamp(30px, 5vw, 64px);
    line-height: 1.02;
    margin: 0.16em 0 0;
    letter-spacing: -0.02em;
  }
  .page__lede {
    color: var(--muted);
    font-size: 15px;
    margin-top: 14px;
  }
  .empty {
    color: var(--faint);
    font-style: italic;
    font-family: 'Spectral', serif;
    font-size: 20px;
    margin-top: 40px;
  }
  .section {
    margin-top: 48px;
  }
  .section__h2 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 22px;
  }
  .artists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 32px;
  }
  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1px;
    border: 1px solid var(--border);
    background: var(--border);
  }
  .tag-result {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    min-height: 150px;
    padding: 24px;
    background: var(--bg);
  }
  .tag-result:hover {
    background: var(--surface);
  }
  .tag-result__name {
    font-family: 'Spectral', serif;
    font-size: 25px;
  }
  .tag-result__count {
    color: var(--faint);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tag-result__description {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .masonry {
    column-count: 2;
    column-gap: 30px;
  }
  @media (min-width: 700px) {
    .masonry {
      column-count: 3;
    }
  }
  @media (min-width: 1100px) {
    .masonry {
      column-count: 4;
    }
  }
</style>

<style is:global>
  .artist-card {
    cursor: pointer;
    display: block;
    transition: opacity 0.2s;
  }
  .artist-card:hover {
    opacity: 0.92;
  }
  .artist-card__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .artist-card__cell {
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--hairline);
  }
  .artist-card__name-only {
    font-family: 'Spectral', serif;
    font-size: 21px;
    margin-top: 13px;
    color: var(--text);
  }
  .artist-card__loc {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 6px;
  }
  .work-card {
    cursor: pointer;
    display: block;
    transition: opacity 0.25s;
  }
  .work-card:hover {
    opacity: 0.86;
  }
  .work-card--masonry {
    break-inside: avoid;
    margin: 0 0 30px;
  }
  .work-card__art {
    width: 100%;
    border: 1px solid var(--hairline);
  }
  .work-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    margin-top: 12px;
  }
  .work-card__meta-l {
    min-width: 0;
  }
  .work-card__title {
    font-family: 'Spectral', serif;
    font-style: italic;
    font-size: 17px;
    line-height: 1.2;
  }
  .work-card__sub {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 5px;
  }
  .work-card__year {
    font-size: 11px;
    font-weight: 500;
    color: var(--faint);
    white-space: nowrap;
  }
</style>
