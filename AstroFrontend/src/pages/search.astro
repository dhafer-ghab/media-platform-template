---
import Layout from '@/layouts/Layout.astro';
import { cleanFilter, parseSort, setCollectionCache } from '@/lib/server/page';

const keyword = cleanFilter(Astro.url.searchParams.get('q'), 100);
const sort = parseSort(Astro.url.searchParams.get('sort'));
if (keyword) {
  if (sort === 'newest') return Astro.redirect(`/search/${encodeURIComponent(keyword)}`);
  return Astro.redirect(`/search/${encodeURIComponent(keyword)}?sort=${encodeURIComponent(sort)}`);
}

setCollectionCache(Astro.response.headers);
---

<Layout
  title="Search published work — Verso"
  description="Search the Verso index by title, description or category."
  robots="noindex,follow"
>
  <main class="container search-landing">
    <div class="eyebrow">Search</div>
    <h1 class="h-display">Find a work.</h1>
    <p>Search published posts by keyword, title, description or category.</p>
    <form action="/search" method="get" role="search">
      <label for="search-query">Keyword</label>
      <div>
        <input id="search-query" type="search" name="q" required maxlength="100" autofocus />
        <button class="btn btn-primary" type="submit">Search</button>
      </div>
    </form>
  </main>
</Layout>

<style>
  .search-landing {
    padding: clamp(54px, 9vw, 120px) 0;
  }
  h1 {
    font-size: clamp(48px, 8vw, 108px);
    margin-top: 0.15em;
  }
  p {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
    max-width: 48ch;
  }
  form {
    display: grid;
    gap: 9px;
    margin-top: 36px;
    max-width: 720px;
  }
  label {
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  form > div { display: flex; }
  input {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    flex: 1;
    font: inherit;
    min-width: 0;
    padding: 0 15px;
  }
</style>
