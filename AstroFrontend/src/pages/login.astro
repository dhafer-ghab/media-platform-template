---
import MediaLayout from '@/layouts/MediaLayout.astro';
import { loginPath, signupPath } from '@/lib/routes';

export const prerender = true;
---

<MediaLayout title="Login" description="Sign in to your Verso account to access your saved media and account settings." path={loginPath()} noindex>
  <main class="container">
    <div class="login-form">
      <h1>Login</h1>
      <form id="login-form">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button type="submit">Login</button>
      </form>
      <p>Don't have an account? <a href={signupPath()}>Sign up</a></p>
    </div>
  </main>
</MediaLayout>

<style>
  .login-form {
    max-width: 400px;
    margin: 50px auto;
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
  }
  .form-group {
    margin-bottom: 20px;
  }
  h1 { font: 600 42px var(--font-serif); }
  label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--text-2);
  }
  input {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
  }
  button {
    width: 100%;
    padding: 13px; border: 0; background: var(--text); color: var(--bg); font-weight: 700; cursor: pointer;
  }
  p {
    margin-top: 20px;
    text-align: center;
    color: var(--muted);
  }
  a {
    color: var(--accent);
    text-decoration: underline;
  }
</style>

<script>
  import { authApi, ApiError } from '@/api';
  import { setToken } from '@/lib/auth';
  import { homePath } from '@/lib/routes';

  document.getElementById('login-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;

    try {
      const { token } = await authApi.login({ email, password });
      setToken(token);
      window.location.href = homePath();
    } catch (error) {
      if (error instanceof ApiError) {
        alert('Login failed. Please check your credentials.');
      }
    }
  });
</script>
