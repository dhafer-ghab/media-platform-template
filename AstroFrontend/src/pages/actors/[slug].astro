---
export const prerender = false;
import { clamp, formatCompact } from '@/lib/text';
import MediaLayout from '@/layouts/MediaLayout.astro';
import AlbumCard from '@/components/media/AlbumCard.astro';
import ActorCard from '@/components/media/ActorCard.astro';
import Pagination from '@/components/media/Pagination.astro';
import { ApiError } from '@/api/client';
import { catalogApi } from '@/api/catalog';
import { actorPath, absoluteUrl, homePath } from '@/lib/routes';
import { imageUrl, placeholderGradient } from '@/lib/images';
import { applyCatalogCache, pageParam, redirectPastLastPage } from '@/lib/http';
import { ALBUMS_PER_PAGE, siteName } from '@/config/site';

const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404 });
const requested = pageParam(Astro.url);
if (requested === null) return new Response('Invalid page.', { status: 400 });
let actor;
let result;
let suggestions;
try {
  [actor, result, suggestions] = await Promise.all([
    catalogApi.actor(slug, { signal: Astro.request.signal }),
    catalogApi.actorAlbums(slug, { page: requested, pageSize: ALBUMS_PER_PAGE }, { signal: Astro.request.signal }),
    catalogApi.actors({ page: 1, pageSize: 8 }, { signal: Astro.request.signal }),
  ]);
} catch (error) {
  if (error instanceof ApiError && error.status === 404) return new Response(null, { status: 404 });
  throw error;
}

const pageRedirect = redirectPastLastPage(requested, result.totalPages, (page) => actorPath(actor.slug, page));
if (pageRedirect) return pageRedirect;
applyCatalogCache(Astro.response);

// ── Presentation ───────────────────────────────────────────────
const onFirst = result.page === 1;
const title = onFirst
  ? `${actor.displayName} — ${actor.profession}`
  : `${actor.displayName} — albums, page ${result.page}`;
const description = clamp(
  onFirst ? actor.bio : `Page ${result.page} of ${result.totalPages}. ${actor.bio}`,
);

const path = actorPath(actor.slug, result.page);
const avatarSrc = imageUrl({ key: actor.avatarStorageKey, id: actor.id }, { width: 320, height: 320, fit: 'cover' });
const realAvatar = !avatarSrc.startsWith('data:') ? absoluteUrl(avatarSrc, Astro.site) : null;

const suggested = suggestions.items.filter((item) => item.id !== actor.id).slice(0, 6);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: absoluteUrl(path, Astro.site),
    dateModified: actor.updatedAt,
    mainEntity: {
      '@type': 'Person',
      name: actor.displayName,
      description: actor.bio,
      jobTitle: actor.profession,
      url: absoluteUrl(actorPath(actor.slug), Astro.site),
      ...(realAvatar ? { image: realAvatar } : {}),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: siteName, item: absoluteUrl(homePath(), Astro.site) },
      { '@type': 'ListItem', position: 2, name: actor.displayName, item: absoluteUrl(actorPath(actor.slug), Astro.site) },
    ],
  },
];
---

<MediaLayout
  title={title}
  description={description}
  path={path}
  ogType="profile"
  image={realAvatar ? { url: realAvatar, width: 320, height: 320, alt: `${actor.displayName}` } : null}
  prevPath={result.hasPrev ? actorPath(actor.slug, result.page - 1) : null}
  nextPath={result.hasNext ? actorPath(actor.slug, result.page + 1) : null}
  jsonLd={jsonLd}
>
  <main>
    <section class="container phero">
      <div class="phero-cover" style={`background:${placeholderGradient(actor.id)};`} aria-hidden="true"></div>

      <div class="phero-row">
        <img
          class="phero-avatar"
          src={avatarSrc}
          width="104"
          height="104"
          alt=""
          fetchpriority="high"
          decoding="sync"
        />

        <div class="phero-id">
          <h1 class="phero-name">{actor.displayName}</h1>
          <p class="phero-role">{actor.profession}</p>
          <p class="phero-bio">{actor.bio}</p>

        </div>

        <dl class="phero-stats">
          <div class="stat"><dt>Albums</dt><dd>{actor.albumCount}</dd></div>
          <div class="stat"><dt>Media</dt><dd>{actor.mediaCount}</dd></div>
          <div class="stat"><dt>Followers</dt><dd>{formatCompact(actor.followerCount)}</dd></div>
        </dl>
      </div>
    </section>

    <section class="container">
      <h2 class="visually-hidden">Albums</h2>
      <div class="albgrid">
        {result.items.map((album, i) =>
          <AlbumCard album={album} actorSlug={actor.slug} eager={result.page === 1 && i < 4} />
        )}
      </div>

      <Pagination
        page={result.page}
        totalPages={result.totalPages}
        hasPrev={result.hasPrev}
        hasNext={result.hasNext}
        hrefFor={(p) => actorPath(actor.slug, p)}
        label={`${actor.displayName} albums`}
      />
    </section>

    {suggested.length > 0 && (
      <section class="container related">
        <h2 class="related__h">More creators</h2>
        <div class="relgrid">
          {suggested.map((a) => <ActorCard actor={a} />)}
        </div>
      </section>
    )}
  </main>
</MediaLayout>

<style>
  .phero { margin: 24px auto 26px; }
  .phero-cover { position: relative; height: 160px; border-radius: var(--radius-md); overflow: hidden; }
  .phero-row {
    display: flex; align-items: flex-end; gap: 22px;
    padding: 16px 8px 0 132px; position: relative;
  }
  .phero-avatar {
    position: absolute; left: 8px; top: -52px;
    width: 104px; height: 104px; border-radius: 50%;
    border: 5px solid var(--bg); object-fit: cover;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25); background: var(--surface);
  }
  .phero-id { flex: 1; padding-bottom: 2px; min-width: 0; }
  .phero-name {
    font-family: var(--font-serif); font-size: 34px; font-weight: 600;
    letter-spacing: -0.015em; margin: 6px 0 4px; color: var(--text);
  }
  .phero-role {
    margin: 0 0 8px; font: 600 12px var(--font-sans);
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent);
  }
  .phero-bio {
    max-width: 520px; color: var(--text-2); font-size: 14.5px;
    margin: 0 0 12px; text-wrap: pretty;
  }
  .phero-stats { display: flex; gap: 24px; padding-bottom: 6px; margin: 0; }
  .stat { display: flex; flex-direction: column-reverse; }
  .stat dd {
    margin: 0; font-family: var(--font-serif); font-size: 24px;
    font-weight: 600; color: var(--accent);
  }
  .stat dt {
    font: 600 10.5px var(--font-sans); letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--faint);
  }

  .albgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 16px;
    padding: 0 8px;
  }

  .related { margin-top: 34px; padding: 0 8px 4px; }
  .related__h {
    font-family: var(--font-serif); font-size: 20px; font-weight: 600;
    margin: 0 0 16px; color: var(--text);
  }
  .relgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 16px; }

  @media (max-width: 640px) {
    .phero-row { flex-direction: column; align-items: flex-start; padding: 60px 0 0; gap: 14px; }
    .phero-avatar { left: 0; top: -46px; }
    .phero-name { font-size: 27px; }
  }
</style>
