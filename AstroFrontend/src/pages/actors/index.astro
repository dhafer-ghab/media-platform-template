---
import { catalogApi } from '@/api/catalog';
import ActorCard from '@/components/media/ActorCard.astro';
import Pagination from '@/components/media/Pagination.astro';
import MediaLayout from '@/layouts/MediaLayout.astro';
import { applyCatalogCache, pageParam, redirectPastLastPage } from '@/lib/http';
import { actorsPath } from '@/lib/routes';

export const prerender = false;

const page = pageParam(Astro.url);
if (page === null) return new Response('Invalid page.', { status: 400 });
const result = await catalogApi.actors({ page, pageSize: 24 }, { signal: Astro.request.signal });
const pageRedirect = redirectPastLastPage(page, result.totalPages, actorsPath);
if (pageRedirect) return pageRedirect;
applyCatalogCache(Astro.response);
const path = actorsPath(result.page);
---

<MediaLayout
  title={result.page > 1 ? `Creators, page ${result.page}` : 'Creators'}
  description="Browse contemporary visual creators in the Verso catalog and discover their latest photography, video, albums, and stories."
  path={path}
  noindex={result.items.length === 0}
  prevPath={result.hasPrev ? actorsPath(result.page - 1) : null}
  nextPath={result.hasNext ? actorsPath(result.page + 1) : null}
>
  <main class="container directory">
    <p class="eyebrow">Directory</p>
    <h1>Creators</h1>
    <p class="count">{result.totalItems} {result.totalItems === 1 ? 'creator' : 'creators'}</p>
    {result.items.length ? <div class="grid">{result.items.map((actor) => <ActorCard actor={actor} />)}</div> : <p class="empty">No creators are available on this page.</p>}
    <Pagination page={result.page} totalPages={result.totalPages} hasPrev={result.hasPrev} hasNext={result.hasNext} hrefFor={actorsPath} label="Creator directory" />
  </main>
</MediaLayout>

<style>
  .directory { padding-top: clamp(38px, 6vw, 76px); }
  .eyebrow { margin: 0; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 8px 0 0; font: 500 clamp(38px, 6vw, 72px)/1 var(--font-serif); }
  .count { margin-bottom: 36px; color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 30px 20px; }
  .empty { padding: 42px; border: 1px dashed var(--border); color: var(--muted); text-align: center; }
</style>
