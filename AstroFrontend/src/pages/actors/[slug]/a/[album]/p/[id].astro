---
export const prerender = false;

import MediaLayout from '@/layouts/MediaLayout.astro';
import Breadcrumbs from '@/components/media/Breadcrumbs.astro';
import { ApiError } from '@/api/client';
import { catalogApi, type PostDetails } from '@/api/catalog';
import { actorPath, albumPath, postPath, absoluteUrl, homePath, tagPath } from '@/lib/routes';
import { imageUrl, imageSrcSet } from '@/lib/images';
import { isNativeVideo, videoUrl, posterUrl } from '@/lib/video';
import { clamp } from '@/lib/text';
import { siteName } from '@/config/site';

const { slug, album: albumSlug, id } = Astro.params;
if (!slug || !albumSlug || !id) return new Response(null, { status: 404 });
let actor;
let album;
let post;
try {
  [actor, album, post] = await Promise.all([
    catalogApi.actor(slug, { signal: Astro.request.signal }),
    catalogApi.album(slug, albumSlug, { signal: Astro.request.signal }),
    catalogApi.postById(id, { signal: Astro.request.signal }),
  ]);
} catch (error) {
  if (error instanceof ApiError && (error.status === 400 || error.status === 404)) return new Response(null, { status: 404 });
  throw error;
}
if (post.actorId !== actor.id || post.albumId !== album.id) return new Response(null, { status: 404 });

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');

// ── Presentation ───────────────────────────────────────────────
/** Post has no title field; the caption names it, the alt text describes it. */
const displayTitle = (p: PostDetails) => clamp(p.caption ?? p.altText, 70);

const heading = displayTitle(post);
const isVideo = post.mediaType === 'video';

const RENDER_W = 1400;
const height = Math.round(RENDER_W / post.aspectRatio);
const WIDTHS = [480, 720, 960, 1200, 1600, 2000];

const ref = { key: post.storageKey, id: post.id };
const poster = isVideo ? posterUrl(ref, { width: RENDER_W, height }) : null;
const src = poster ?? imageUrl(ref, { width: RENDER_W, height, fit: 'contain' });
const srcset = isVideo ? '' : imageSrcSet(ref, WIDTHS, { aspectRatio: post.aspectRatio, fit: 'contain' });
const videoAsset = isVideo ? videoUrl(ref) : null;
const playable = videoAsset && isNativeVideo(post.mimeType) ? videoAsset : null;
const realImage = !src.startsWith('data:');
const contentAsset = isVideo ? videoAsset : realImage ? src : null;

const mmss =
  post.durationSeconds != null
    ? `${Math.floor(post.durationSeconds / 60)}:${String(post.durationSeconds % 60).padStart(2, '0')}`
    : null;

/** Schema.org wants ISO 8601, not mm:ss. */
const iso8601 = (s: number) => `PT${Math.floor(s / 60)}M${s % 60}S`;

const path = postPath(actor.slug, album.slug, post.id);

const description = clamp(
  `${post.altText}. From ${album.title} by ${actor.displayName}, ${actor.profession}.`,
);

const crumbs = [
  { label: siteName, href: homePath() },
  { label: actor.displayName, href: actorPath(actor.slug) },
  { label: album.title, href: albumPath(actor.slug, album.slug) },
  { label: heading },
];

// Only emitted with real assets — a data-URI contentUrl or thumbnailUrl is
// invalid structured data, and an invalid entity is worse than none.
const mediaLd = contentAsset
  ? {
      '@context': 'https://schema.org',
      '@type': isVideo ? 'VideoObject' : 'ImageObject',
      name: heading,
      description: post.altText,
      uploadDate: post.publishedAt,
      contentUrl: absoluteUrl(contentAsset, Astro.site),
      ...(isVideo && poster && !poster.startsWith('data:') ? { thumbnailUrl: absoluteUrl(poster, Astro.site) } : {}),
      ...(post.durationSeconds != null ? { duration: iso8601(post.durationSeconds) } : {}),
      representativeOfPage: true,
      author: {
        '@type': 'Person',
        name: actor.displayName,
        url: absoluteUrl(actorPath(actor.slug), Astro.site),
      },
      isPartOf: {
        '@type': 'ImageGallery',
        name: album.title,
        url: absoluteUrl(albumPath(actor.slug, album.slug), Astro.site),
      },
    }
  : null;

const jsonLd = [
  ...(mediaLd ? [mediaLd] : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      ...(c.href ? { item: absoluteUrl(c.href, Astro.site) } : {}),
    })),
  },
];
---

<MediaLayout
  title={`${heading} — ${album.title}`}
  description={description}
  path={path}
  ogType="article"
  image={realImage ? { url: absoluteUrl(src, Astro.site), width: RENDER_W, height, alt: post.altText } : null}
  jsonLd={jsonLd}
>
  <main>
    <div class="container post">
      <Breadcrumbs items={crumbs} />

      <figure class="post-figure" style={`--ar:${post.aspectRatio};`}>
        {playable ? (
          <video
            class="post-media"
            controls
            preload="none"
            playsinline
            poster={poster}
            width={RENDER_W}
            height={height}
            aria-label={post.altText}
          >
            <source src={playable} type={post.mimeType} />
            <a href={playable}>Open video</a>
          </video>
        ) : (
          <div class="post-mediawrap">
            <img
              class="post-media"
              src={src}
              srcset={srcset || undefined}
              sizes={srcset ? '(min-width: 1040px) 1000px, 94vw' : undefined}
              width={RENDER_W}
              height={height}
              alt={post.altText}
              loading="eager"
              decoding="sync"
              fetchpriority="high"
            />
            {isVideo && (
              <span class="post-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
            )}
          </div>
        )}

        {isVideo && videoAsset && !playable && (
          <p class="post-fallback"><a href={videoAsset}>Open video</a></p>
        )}

        <h1 class="post-h1">{heading}</h1>
        {post.caption && post.caption !== heading && (
          <figcaption class="post-cap">{post.caption}</figcaption>
        )}
      </figure>

      <p class="post-metaline">
        <a class="post-owner" href={actorPath(actor.slug)}>{actor.displayName}</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={albumPath(actor.slug, album.slug)}>{album.title}</a>
        {mmss && (
          <Fragment>
            <span class="sep" aria-hidden="true">·</span>
            <span>{mmss}</span>
          </Fragment>
        )}
        <span class="sep" aria-hidden="true">·</span>
        <time datetime={post.publishedAt}>{post.publishedAt}</time>
      </p>

      {post.tags.length > 0 && (
        <section class="post-tags">
          <h2 class="post-h2">Tags</h2>
          <ul class="taglist">
            {post.tags.map((t) => <li><a class="tag" href={tagPath(t)}>{t}</a></li>)}
          </ul>
        </section>
      )}
    </div>
  </main>
</MediaLayout>

<style>
  .post { max-width: 1000px; }
  .post-figure { margin: 0; }
  .post-mediawrap { position: relative; }

  .post-media {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar);
    border-radius: var(--radius-md);
    background: var(--surface);
    object-fit: cover;
  }

  .post-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 74px;
    height: 74px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    padding-left: 4px;
  }

  .post-fallback { margin: 10px 2px 0; }
  .post-fallback a { color: var(--accent); font-weight: 600; }

  .post-h1 {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 20px 2px 0;
    color: var(--text);
    text-wrap: balance;
  }

  .post-cap {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.55;
    margin: 10px 2px 0;
    max-width: 660px;
    text-wrap: pretty;
  }

  .post-metaline {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 16px 2px 0;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--hairline);
    color: var(--muted);
    font: 600 13px var(--font-sans);
  }
  .post-metaline a:hover { color: var(--accent); }
  .post-owner { color: var(--accent); }
  .sep { color: var(--faint); }

  .post-tags {
    margin: 36px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
  }
  .post-h2 {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 14px;
    color: var(--text);
  }
  .taglist {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tag {
    font-size: 12px;
    border-radius: 999px;
    padding: 6px 12px;
    background: var(--chip-bg);
    border: 1px solid var(--border-soft);
    color: var(--text-2);
  }
</style>
