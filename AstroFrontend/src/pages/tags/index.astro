---
export const prerender = false;

import { catalogApi } from '@/api/catalog';
import MediaLayout from '@/layouts/MediaLayout.astro';
import { tagPath, tagsPath } from '@/lib/routes';

const tags = await catalogApi.tags({ signal: Astro.request.signal });
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=600, stale-while-revalidate=1200');
---

<MediaLayout title="Tags" description="Browse every subject and theme in the Verso media catalog, then explore matching albums from contemporary visual creators." path={tagsPath()}>
  <main class="container tags">
    <p class="eyebrow">Catalog index</p>
    <h1>Tags</h1>
    <p class="lede">Browse the catalog by subject and theme.</p>
    {tags.length ? <ul>{tags.map((tag) => <li><a href={tagPath(tag)}>{tag}</a></li>)}</ul> : <p class="empty">No tags are available yet.</p>}
  </main>
</MediaLayout>

<style>
  .tags { padding-top: clamp(38px, 6vw, 76px); }
  .eyebrow { margin: 0; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 8px 0 0; font: 500 clamp(38px, 6vw, 72px)/1 var(--font-serif); }
  .lede, .empty { color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; gap: 12px; margin: 34px 0 0; padding: 0; list-style: none; }
  a { display: block; padding: 10px 16px; border: 1px solid var(--border); border-radius: 999px; }
  a:hover, a:focus-visible { border-color: var(--accent); color: var(--accent); }
</style>
