---
import Layout from '@/layouts/Layout.astro';
import { galleryTags, artworksByTag } from '@/data/gallery';

const title = 'Art Tags — Explore Contemporary Art Themes | Verso';
const description = 'Browse contemporary art by theme, from abstract and minimal works to landscape, portrait, geometric and color field art.';
const siteUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL('/tags', siteUrl).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Contemporary art tags',
    description,
    url: pageUrl,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: galleryTags.length,
      itemListElement: galleryTags.map((tag, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tag.name,
        url: new URL(`/tags/${tag.slug}`, siteUrl).toString(),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Discover', item: new URL('/', siteUrl).toString() },
      { '@type': 'ListItem', position: 2, name: 'Tags', item: pageUrl },
    ],
  },
];
---

<Layout title={title} description={description} canonicalPath="/tags" jsonLd={jsonLd}>
  <main class="container page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Discover</a>
      <span class="crumb-sep" aria-hidden="true">/</span>
      <span aria-current="page">Tags</span>
    </nav>

    <header class="intro">
      <div class="eyebrow">Themes across the index</div>
      <h1 class="h-display intro__title">Explore art by tag.</h1>
      <p class="intro__lede">
        Follow recurring ideas, visual languages and subjects across the Verso index. Each tag connects works by different artists and disciplines.
      </p>
    </header>

    <section class="directory" aria-labelledby="tag-directory-title">
      <div class="directory__head">
        <div>
          <div class="eyebrow">Directory</div>
          <h2 id="tag-directory-title" class="h-section">Find a tag</h2>
        </div>
        <p class="directory__count" data-tag-count role="status" aria-live="polite">{galleryTags.length} tags</p>
      </div>

      <form class="tag-search" role="search" action="/tags" method="get" data-tag-search>
        <svg class="tag-search__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.3-4.3"></path>
        </svg>
        <label class="tag-search__label" for="tag-query">Search the tag directory</label>
        <input id="tag-query" type="search" name="q" placeholder="Search by theme, subject or style..." autocomplete="off" data-tag-query />
        <button type="button" class="tag-search__clear" data-tag-clear hidden>Clear</button>
      </form>

      <p class="tag-empty" data-tag-empty hidden>
        No tags match your search. Try a broader theme or style.
      </p>

      <div class="tag-grid" aria-label="All art tags" data-tag-grid>
      {galleryTags.map((tag, index) => {
        const preview = artworksByTag(tag.name)[0];
        return (
          <article class="tag-card" data-tag-card data-tag-name={tag.name.toLowerCase()} data-search={`${tag.name} ${tag.description}`.toLowerCase()}>
            <a class="tag-card__image-link" href={`/tags/${tag.slug}`} aria-label={`Explore ${tag.name} art`}>
              <span class="tag-card__image" style={`background:${preview?.bg ?? 'var(--surface)'}`}></span>
              <span class="tag-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            </a>
            <div class="tag-card__content">
              <div class="tag-card__head">
                <h3><a href={`/tags/${tag.slug}`}>{tag.name}</a></h3>
                <span>{tag.count} {tag.count === 1 ? 'work' : 'works'}</span>
              </div>
              <p>{tag.description}</p>
              <a class="tag-card__link" href={`/tags/${tag.slug}`} aria-label={`Explore ${tag.name} art`}>
                Explore <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })}
      </div>
    </section>
  </main>

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-tag-search]');
    const input = document.querySelector<HTMLInputElement>('[data-tag-query]');
    const clear = document.querySelector<HTMLButtonElement>('[data-tag-clear]');
    const count = document.querySelector<HTMLElement>('[data-tag-count]');
    const empty = document.querySelector<HTMLElement>('[data-tag-empty]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-tag-card]')];

    const normalize = (value: string): string =>
      value.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').trim();

    function filterTags(query: string, updateUrl = true): void {
      const terms = normalize(query).split(/\s+/).filter(Boolean);
      let visible = 0;

      cards.forEach((card) => {
        const haystack = normalize(card.dataset.search ?? '');
        const matches = terms.every((term) => haystack.includes(term));
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      if (count) count.textContent = `${visible} ${visible === 1 ? 'tag' : 'tags'}`;
      if (empty) empty.hidden = visible !== 0;
      if (clear) clear.hidden = query.length === 0;

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        window.history.replaceState({}, '', url);
      }
    }

    if (input) {
      const initialQuery = new URLSearchParams(window.location.search).get('q') ?? '';
      input.value = initialQuery;
      filterTags(initialQuery, false);
      input.addEventListener('input', () => filterTags(input.value));
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!input) return;

      filterTags(input.value);
      const query = normalize(input.value);
      if (!query) return;

      const destination = cards.find(
        (card) => !card.hidden && normalize(card.dataset.tagName ?? '') === query,
      );
      const link = destination?.querySelector<HTMLAnchorElement>('h3 a');
      if (link) window.location.assign(link.href);
    });

    clear?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      filterTags('');
      input.focus();
    });
  </script>
</Layout>

<style>
  .page {
    padding: clamp(34px, 5vw, 72px) 0 clamp(64px, 8vw, 112px);
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(240px, 0.75fr);
    gap: 40px;
    align-items: end;
    padding: clamp(38px, 7vw, 92px) 0 clamp(42px, 6vw, 76px);
    border-bottom: 1px solid var(--border);
  }
  .intro .eyebrow {
    grid-column: 1 / -1;
    margin-bottom: -20px;
  }
  .intro__title {
    font-size: clamp(48px, 7.5vw, 104px);
    max-width: 11ch;
  }
  .intro__lede {
    color: var(--muted);
    font-family: 'Spectral', serif;
    font-size: clamp(17px, 1.8vw, 22px);
    line-height: 1.5;
    margin: 0 0 8px;
  }
  .directory {
    padding-top: clamp(42px, 6vw, 72px);
  }
  .directory__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .directory__head h2 {
    font-size: clamp(28px, 3.2vw, 42px);
    margin-top: 8px;
  }
  .directory__count {
    color: var(--faint);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin: 0 0 6px;
    text-transform: uppercase;
  }
  .tag-search {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    margin-top: 26px;
    padding: 0 2px 15px;
    border-bottom: 1px solid var(--ink);
    color: var(--muted);
  }
  .tag-search:focus-within {
    border-color: var(--accent);
  }
  .tag-search__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .tag-search input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-family: 'Spectral', serif;
    font-size: clamp(20px, 2.5vw, 30px);
  }
  .tag-search input::-webkit-search-cancel-button {
    display: none;
  }
  .tag-search__clear {
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 8px 0 8px 14px;
    text-transform: uppercase;
  }
  .tag-search__clear:hover {
    color: var(--accent);
  }
  .tag-empty {
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-family: 'Spectral', serif;
    font-size: 20px;
    font-style: italic;
  }
  .tag-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(24px, 4vw, 56px);
    margin-top: 34px;
  }
  .tag-card {
    min-height: 390px;
    padding: 0 0 26px;
    border-top: 1px solid var(--border);
  }
  .tag-card__image-link {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    margin-top: 20px;
    overflow: hidden;
    border: 1px solid var(--hairline);
  }
  .tag-card__image {
    position: absolute;
    inset: 0;
    transition: transform 0.4s ease;
  }
  .tag-card__image-link:hover .tag-card__image {
    transform: scale(1.025);
  }
  .tag-card__number {
    position: absolute;
    z-index: 1;
    top: 12px;
    left: 12px;
    padding: 5px 7px;
    background: var(--bg);
    color: var(--faint);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .tag-card__content {
    display: flex;
    flex-direction: column;
    min-height: 205px;
    padding-top: 22px;
  }
  .tag-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .tag-card h3 {
    font-family: 'Spectral', serif;
    font-size: clamp(23px, 2.2vw, 31px);
    font-weight: 400;
    line-height: 1;
    margin: 0;
  }
  .tag-card__head > span {
    color: var(--faint);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .tag-card p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
    margin: 20px 0 24px;
  }
  .tag-card__link {
    align-self: flex-start;
    color: var(--text-2);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-top: auto;
    text-transform: uppercase;
  }
  .tag-card__link:hover {
    color: var(--accent);
  }
  @media (max-width: 920px) {
    .tag-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .intro .eyebrow {
      grid-column: auto;
      margin-bottom: 0;
    }
  }
  @media (max-width: 560px) {
    .tag-grid {
      grid-template-columns: 1fr;
    }
    .tag-card {
      min-height: 370px;
    }
    .tag-search {
      gap: 10px;
    }
  }
</style>
