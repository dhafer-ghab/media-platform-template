---
import Layout from '@/layouts/Layout.astro';
import WorkCard from '@/components/ui/WorkCard.astro';
import { allTags, artworksByTag, artistsByTag } from '@/data/gallery';

export const prerender = true;

export function getStaticPaths() {
  return allTags.map((t) => ({ params: { tag: t.toLowerCase() } }));
}

const { tag: tagParam } = Astro.params;
const tagName = allTags.find((t) => t.toLowerCase() === tagParam);
if (!tagName) {
  return Astro.redirect('/');
}

const works = artworksByTag(tagName);
const tagArtists = artistsByTag(tagName);
---

<Layout title={`${tagName} — Verso`}>
  <main class="container page">
    <a class="back-link" href="/">← Discover</a>
    <div class="eyebrow" style="margin-top:22px">Tag</div>
    <h1 class="h-display page__h1">{tagName}</h1>
    {tagArtists.length > 0 && (
      <div class="tag-artists">
        <span class="tag-artists__label">Artists</span>
        {tagArtists.map((a) => (
          <a class="tag-artists__chip" href={`/artists/${a.slug}`}>{a.name}</a>
        ))}
      </div>
    )}
    <div class="masonry">
      {works.map((w) => <WorkCard work={w} variant="masonry" />)}
    </div>
  </main>
</Layout>

<style>
  .page {
    padding: clamp(36px, 5vw, 72px) 0;
  }
  .page__h1 {
    font-size: clamp(34px, 5.5vw, 72px);
    margin: 0.12em 0 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .tag-artists {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
    align-items: center;
  }
  .tag-artists__label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin-right: 4px;
  }
  .tag-artists__chip {
    cursor: pointer;
    font-family: 'Spectral', serif;
    font-size: 16px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    transition: border-color 0.2s;
  }
  .tag-artists__chip:hover {
    border-color: var(--ink);
  }
  .masonry {
    column-count: 2;
    column-gap: 30px;
    margin-top: 38px;
  }
  @media (min-width: 700px) {
    .masonry {
      column-count: 3;
    }
  }
  @media (min-width: 1100px) {
    .masonry {
      column-count: 4;
    }
  }
</style>
