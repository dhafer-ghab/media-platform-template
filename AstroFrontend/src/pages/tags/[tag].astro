---
import Pagination from '@/components/Pagination.astro';
import PostGrid from '@/components/PostGrid.astro';
import Layout from '@/layouts/Layout.astro';
import type { PagedPosts } from '@/lib/server/posts';
import { getPosts } from '@/lib/server/posts';
import { cleanFilter, parsePage, parseSort, setCollectionCache, setNoStore } from '@/lib/server/page';

const tag = cleanFilter(Astro.params.tag ?? '', 50).toLowerCase();
if (!tag) return Astro.redirect('/explore');

const page = parsePage(Astro.url.searchParams.get('page'));
const sort = parseSort(Astro.url.searchParams.get('sort'));
let error = '';
let result: PagedPosts = { items: [], page, pageSize: 20, totalCount: 0, totalPages: 0 };

try {
  result = await getPosts({ tag, sort, page, pageSize: 20 });
  setCollectionCache(Astro.response.headers);
} catch {
  error = 'This tag could not be loaded. Please try again shortly.';
  Astro.response.status = 502;
  setNoStore(Astro.response.headers);
}
---

<Layout
  title={`#${tag} — Verso`}
  description={`Published work tagged ${tag}.`}
  canonical={`${Astro.url.origin}/tags/${encodeURIComponent(tag)}`}
>
  <main class="container tag-page">
    <a class="back-link" href="/explore">← Explore</a>
    <div class="eyebrow">Tag</div>
    <h1 class="h-display">#{tag}</h1>

    <form class="tag-tools" action={`/tags/${encodeURIComponent(tag)}`} method="get">
      <p><strong>{result.totalCount}</strong> published {result.totalCount === 1 ? 'work' : 'works'}</p>
      <label>
        <span>Sort</span>
        <select name="sort">
          <option value="newest" selected={sort === 'newest'}>Newest first</option>
          <option value="popular" selected={sort === 'popular'}>Most viewed</option>
          <option value="oldest" selected={sort === 'oldest'}>Oldest first</option>
          <option value="title" selected={sort === 'title'}>Title A–Z</option>
        </select>
      </label>
      <button class="btn btn-primary" type="submit">Apply</button>
    </form>

    {error ? (
      <div class="error-state" role="alert">{error}</div>
    ) : (
      <>
        <PostGrid posts={result.items} emptyMessage={`No published works use #${tag} yet.`} />
        <Pagination
          page={result.page}
          totalPages={result.totalPages}
          basePath={`/tags/${encodeURIComponent(tag)}`}
          params={{ sort: sort === 'newest' ? undefined : sort }}
        />
      </>
    )}
  </main>
</Layout>

<style>
  .tag-page { padding: clamp(40px, 6vw, 76px) 0 100px; }
  .eyebrow { margin-top: 24px; }
  h1 {
    font-size: clamp(46px, 8vw, 104px);
    margin: 0.12em 0 34px;
  }
  .tag-tools {
    align-items: end;
    border-bottom: 1px solid var(--border-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 32px;
    padding-bottom: 22px;
  }
  .tag-tools p { color: var(--muted); margin: 0 auto 12px 0; }
  .tag-tools label { display: grid; gap: 5px; }
  .tag-tools label span {
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  select {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    min-height: 44px;
    padding: 0 12px;
  }
  .error-state {
    border: 1px solid var(--border-soft);
    color: var(--muted);
    padding: 42px;
    text-align: center;
  }
</style>
