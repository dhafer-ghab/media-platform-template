---
export const prerender = false;

import { catalogApi } from '@/api/catalog';
import AlbumCard from '@/components/media/AlbumCard.astro';
import Pagination from '@/components/media/Pagination.astro';
import MediaLayout from '@/layouts/MediaLayout.astro';
import { applyCatalogCache, pageParam, redirectPastLastPage } from '@/lib/http';
import { tagPath, tagsPath } from '@/lib/routes';

const page = pageParam(Astro.url);
if (page === null) return new Response('Invalid page.', { status: 400 });
const tag = Astro.params.tag ?? '';
if (!tag) return new Response(null, { status: 404 });

const result = await catalogApi.discovery({ tag, page, pageSize: 24 }, { signal: Astro.request.signal });
const pageRedirect = redirectPastLastPage(page, result.totalPages, (lastPage) => tagPath(tag, lastPage));
if (pageRedirect) return pageRedirect;
applyCatalogCache(Astro.response);
const path = tagPath(tag, result.page);
---

<MediaLayout title={result.page > 1 ? `${tag}, page ${result.page}` : tag}
  description={`Explore albums tagged ${tag} in the Verso catalog, with photography, video, and contemporary visual stories.`}
  path={path} noindex={result.items.length === 0}
  prevPath={result.hasPrev ? tagPath(tag, result.page - 1) : null}
  nextPath={result.hasNext ? tagPath(tag, result.page + 1) : null}>
  <main class="container page-content">
    <a class="back" href={tagsPath()}>All tags</a>
    <p class="eyebrow">Tag</p><h1>{tag}</h1><p class="count">{result.totalItems} albums</p>
    {result.items.length ? <div class="grid">{result.items.map((item, index) => <AlbumCard album={item} eager={page === 1 && index < 4} />)}</div> : <p class="empty">No albums use this tag.</p>}
    <Pagination page={result.page} totalPages={result.totalPages} hasPrev={result.hasPrev} hasNext={result.hasNext} hrefFor={(nextPage) => tagPath(tag, nextPage)} label={`${tag} results`} />
  </main>
</MediaLayout>

<style>
  .page-content { padding-top: clamp(38px, 6vw, 76px); }
  .back, .eyebrow { color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .eyebrow { margin: 26px 0 0; }
  h1 { margin: 8px 0 0; font: 500 clamp(38px, 6vw, 72px)/1 var(--font-serif); }
  .count { margin-bottom: 32px; color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  .empty { padding: 42px; border: 1px dashed var(--border); color: var(--muted); text-align: center; }
</style>
