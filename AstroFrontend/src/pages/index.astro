---
import Layout from '@/layouts/Layout.astro';
import PostCard from '@/components/PostCard.astro';
import PostGrid from '@/components/PostGrid.astro';
import { getPostFacets, getPosts } from '@/lib/server/posts';
import { setHomeCache, setNoStore } from '@/lib/server/page';

const [popularResult, newestResult, facetsResult] = await Promise.allSettled([
  getPosts({ sort: 'popular', pageSize: 6 }),
  getPosts({ sort: 'newest', pageSize: 12 }),
  getPostFacets(),
]);

const popular = popularResult.status === 'fulfilled' ? popularResult.value.items : [];
const newest = newestResult.status === 'fulfilled' ? newestResult.value.items : [];
const facets = facetsResult.status === 'fulfilled'
  ? facetsResult.value
  : { categories: [], tags: [] };
const unavailable = popularResult.status === 'rejected' && newestResult.status === 'rejected';

if (unavailable) setNoStore(Astro.response.headers);
else setHomeCache(Astro.response.headers);
---

<Layout>
  <main>
    <section class="container hero">
      <div class="eyebrow">The public index</div>
      <h1 class="h-display">Discover work worth returning to.</h1>
      <p>
        A living collection of published work, ordered by what people view and what artists upload next.
      </p>
      <div class="hero__actions">
        <a class="btn btn-primary" href="/explore">Explore all works</a>
        <a class="btn btn-ghost" href="/search">Search the index</a>
      </div>
    </section>

    {unavailable ? (
      <section class="container unavailable" role="status">
        <h2>The collection is temporarily unavailable.</h2>
        <p>Please try again in a moment.</p>
      </section>
    ) : (
      <>
        <section class="popular">
          <div class="container section-wrap">
            <header class="section-head">
              <div>
                <div class="eyebrow">Popular now</div>
                <h2 class="h-section">Most viewed</h2>
              </div>
              <a href="/explore?sort=popular">See the full ranking →</a>
            </header>
            {popular.length > 0 ? (
              <div class="popular-grid">
                {popular.map((post) => <PostCard post={post} featured />)}
              </div>
            ) : (
              <p class="section-empty">Popular works will appear as the collection receives views.</p>
            )}
          </div>
        </section>

        <section class="container section-wrap newest">
          <header class="section-head">
            <div>
              <div class="eyebrow">Fresh from the studio</div>
              <h2 class="h-section">Newest uploads</h2>
            </div>
            <a href="/explore?sort=newest">Explore all works →</a>
          </header>
          <PostGrid posts={newest} emptyMessage="No published uploads yet." />
        </section>

        {(facets.categories.length > 0 || facets.tags.length > 0) && (
          <section class="browse">
            <div class="container browse__grid">
              <div>
                <div class="eyebrow">Browse by category</div>
                <div class="browse__links">
                  {facets.categories.slice(0, 8).map((facet) => (
                    <a href={`/explore?category=${encodeURIComponent(facet.name)}`}>
                      {facet.name} <span>{facet.count}</span>
                    </a>
                  ))}
                </div>
              </div>
              <div>
                <div class="eyebrow">Follow a tag</div>
                <div class="browse__tags">
                  {facets.tags.slice(0, 12).map((facet) => (
                    <a class="tag-pill" href={`/tags/${encodeURIComponent(facet.name)}`}>
                      #{facet.name} <span>{facet.count}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </section>
        )}
      </>
    )}
  </main>
</Layout>

<style>
  .hero {
    padding: clamp(58px, 9vw, 118px) 0 clamp(44px, 7vw, 88px);
  }
  .hero h1 {
    font-size: clamp(48px, 8vw, 112px);
    margin-top: 0.18em;
    max-width: 13ch;
  }
  .hero p {
    color: var(--muted);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    margin: 30px 0 0;
    max-width: 54ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  .section-wrap {
    padding: clamp(48px, 7vw, 90px) 0;
  }
  .section-head {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    justify-content: space-between;
    margin-bottom: 34px;
  }
  .section-head h2 {
    font-size: clamp(30px, 4.2vw, 54px);
    margin-top: 8px;
  }
  .section-head > a {
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .section-head > a:hover { color: var(--accent); }
  .popular {
    background: var(--surface);
    border-bottom: 1px solid var(--border-soft);
    border-top: 1px solid var(--border-soft);
  }
  .popular-grid {
    display: grid;
    gap: 28px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .newest { padding-bottom: clamp(58px, 8vw, 105px); }
  .section-empty { color: var(--muted); font-style: italic; }
  .browse {
    border-top: 1px solid var(--border-soft);
    padding: clamp(48px, 7vw, 88px) 0;
  }
  .browse__grid {
    display: grid;
    gap: clamp(34px, 6vw, 90px);
    grid-template-columns: 1fr 1fr;
  }
  .browse__links {
    display: grid;
    margin-top: 22px;
  }
  .browse__links a {
    border-bottom: 1px solid var(--border-soft);
    display: flex;
    font-family: 'Spectral', serif;
    font-size: 22px;
    justify-content: space-between;
    padding: 12px 0;
  }
  .browse__links a:hover { color: var(--accent); }
  .browse__links span,
  .browse__tags span { color: var(--faint); font-family: 'Archivo', sans-serif; font-size: 11px; }
  .browse__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .unavailable {
    border: 1px solid var(--border-soft);
    margin-bottom: 80px;
    padding: 48px;
  }
  .unavailable h2 { font-family: 'Spectral', serif; font-weight: 400; }
  .unavailable p { color: var(--muted); }
  @media (max-width: 850px) {
    .popular-grid { grid-template-columns: 1fr; }
    .browse__grid { grid-template-columns: 1fr; }
  }
</style>
