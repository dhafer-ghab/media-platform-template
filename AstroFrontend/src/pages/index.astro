---
export const prerender = false;

import { catalogApi } from '@/api/catalog';
import AlbumCard from '@/components/media/AlbumCard.astro';
import ActorCard from '@/components/media/ActorCard.astro';
import Pagination from '@/components/media/Pagination.astro';
import MediaLayout from '@/layouts/MediaLayout.astro';
import { applyCatalogCache, pageParam, redirectPastLastPage } from '@/lib/http';
import { explorePath, homePath, tagsPath } from '@/lib/routes';

const page = pageParam(Astro.url);
if (page === null) return new Response('Invalid page.', { status: 400 });

const [discovery, actors] = await Promise.all([
  catalogApi.discovery({ page, pageSize: 12 }, { signal: Astro.request.signal }),
  catalogApi.actors({ page: 1, pageSize: 8 }, { signal: Astro.request.signal }),
]);
const pageRedirect = redirectPastLastPage(page, discovery.totalPages, homePath);
if (pageRedirect) return pageRedirect;
applyCatalogCache(Astro.response);

const path = homePath(discovery.page);
const title = discovery.page === 1 ? 'Discover contemporary visual artists' : `Discover, page ${discovery.page}`;
const description = 'Discover a curated catalog of contemporary visual artists, albums, photography, and video, selected for thoughtful browsing.';
---

<MediaLayout
  title={title}
  description={description}
  path={path}
  prevPath={discovery.hasPrev ? homePath(discovery.page - 1) : null}
  nextPath={discovery.hasNext ? homePath(discovery.page + 1) : null}
  noindex={discovery.items.length === 0}
>
  <main>
    <section class="container hero">
      <p class="eyebrow">The catalog</p>
      <h1>An index of contemporary visual artists.</h1>
      <p class="lede">A slow place to discover photography, moving image, and visual stories from creators around the world.</p>
      <div class="actions">
        <a class="primary" href={explorePath()}>Explore the catalog</a>
        <a class="secondary" href={tagsPath()}>Browse tags</a>
      </div>
    </section>

    {actors.items.length > 0 && discovery.page === 1 && (
      <section class="container creators">
        <div class="section-head"><h2>Featured creators</h2><a href={explorePath()}>View catalog</a></div>
        <div class="actor-grid">{actors.items.map((actor) => <ActorCard actor={actor} />)}</div>
      </section>
    )}

    <section class="container recent">
      <div class="section-head"><h2>Recently added</h2><span>{discovery.totalItems} albums</span></div>
      {discovery.items.length > 0 ? (
        <div class="album-grid">{discovery.items.map((album, index) => <AlbumCard album={album} eager={page === 1 && index < 4} />)}</div>
      ) : (
        <p class="empty">No catalog entries are available on this page.</p>
      )}
      <Pagination
        page={discovery.page}
        totalPages={discovery.totalPages}
        hasPrev={discovery.hasPrev}
        hasNext={discovery.hasNext}
        hrefFor={homePath}
        label="Catalog pages"
      />
    </section>
  </main>
</MediaLayout>

<style>
  .hero { padding: clamp(54px, 9vw, 120px) 0 clamp(42px, 7vw, 84px); }
  .eyebrow { margin: 0; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  h1 { max-width: 12ch; margin: 12px 0 0; font: 500 clamp(42px, 7.5vw, 100px)/.98 var(--font-serif); letter-spacing: -.035em; text-wrap: balance; }
  .lede { max-width: 54ch; margin: 28px 0 0; color: var(--text-2); font-size: clamp(16px, 1.5vw, 19px); line-height: 1.65; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .actions a { padding: 13px 20px; border: 1px solid var(--text); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .primary { color: var(--bg); background: var(--text); }
  .creators, .recent { padding-top: 38px; border-top: 1px solid var(--hairline); }
  .recent { margin-top: 56px; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .section-head h2 { margin: 0; font: 600 clamp(23px, 3vw, 34px) var(--font-serif); }
  .section-head a, .section-head span { color: var(--muted); font-size: 12px; }
  .actor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 24px; }
  .album-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  .empty { padding: 42px; border: 1px dashed var(--border); color: var(--muted); text-align: center; }
</style>
