---
import Layout from '@/layouts/Layout.astro';
import CategoryCard from '@/components/ui/CategoryCard.astro';
import { categories } from '@/data/gallery';

export const prerender = true;
---

<Layout title="Categories — Verso">
  <main class="container page">
    <div class="eyebrow">Index</div>
    <h1 class="h-display page__h1">Categories</h1>
    <p class="page__lede">Browse the index by medium and discipline.</p>
    <div class="grid">
      {categories.map((c) => (
        <CategoryCard name={c.name} count={c.count} bg={c.bg} slug={c.slug} size="lg" showWorksSuffix />
      ))}
    </div>
  </main>
</Layout>

<style>
  .page {
    padding: clamp(40px, 6vw, 80px) 0;
  }
  .page__h1 {
    font-size: clamp(34px, 5.5vw, 74px);
    margin: 0.18em 0 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .page__lede {
    color: var(--muted);
    font-size: 16px;
    margin-top: 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 26px;
    margin-top: 40px;
  }
</style>
