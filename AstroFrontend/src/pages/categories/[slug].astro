---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import WorkCard from '@/components/ui/WorkCard.astro';
import { categories, artworksByCategory } from '@/data/gallery';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const cat = categories.find((c) => c.slug === slug);
if (!cat) {
  return Astro.redirect('/categories');
}

const baseWorks = artworksByCategory(cat.name);
const tags = [...new Set(baseWorks.flatMap((w) => w.tags))].sort();
---

<Layout title={`${cat.name} — Verso`}>
  <main class="container page">
    <a class="back-link" href="/categories">← All categories</a>
    <h1 class="h-display page__h1">{cat.name}</h1>
    <p class="page__lede">{baseWorks.length} works in the index</p>

    <div class="chips" data-cat-chips>
      <a class="chip is-active" href={`/categories/${cat.slug}`} data-cat-chip="">All</a>
      {tags.map((t) => (
        <a class="chip" href={`/categories/${cat.slug}?tag=${encodeURIComponent(t)}`} data-cat-chip={t}>
          {t}
        </a>
      ))}
    </div>

    <p class="empty" data-cat-empty hidden>No works match this filter.</p>

    <div class="masonry">
      {baseWorks.map((w) => (
        <div data-cat-work data-tags={w.tags.join('|')}>
          <WorkCard work={w} variant="masonry" />
        </div>
      ))}
    </div>
  </main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const tag = (params.get('tag') ?? '').trim();

    const chips = document.querySelectorAll<HTMLAnchorElement>('[data-cat-chip]');
    chips.forEach((c) => {
      const t = c.dataset.catChip ?? '';
      c.classList.toggle('is-active', t === tag);
    });

    const works = document.querySelectorAll<HTMLElement>('[data-cat-work]');
    let visible = 0;
    works.forEach((w) => {
      const tags = (w.dataset.tags ?? '').split('|');
      const show = !tag || tags.includes(tag);
      w.hidden = !show;
      if (show) visible += 1;
    });

    const empty = document.querySelector<HTMLElement>('[data-cat-empty]');
    if (empty) empty.hidden = visible !== 0;
  </script>
</Layout>

<style>
  .page {
    padding: clamp(36px, 5vw, 72px) 0;
  }
  .page__h1 {
    font-size: clamp(34px, 5.5vw, 72px);
    margin: 0.2em 0 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .page__lede {
    color: var(--muted);
    font-size: 15px;
    margin-top: 14px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 38px;
  }
  .empty {
    color: var(--faint);
    font-style: italic;
    font-family: 'Spectral', serif;
    font-size: 18px;
  }
  .masonry {
    column-count: 2;
    column-gap: 30px;
  }
  @media (min-width: 700px) {
    .masonry {
      column-count: 3;
    }
  }
  @media (min-width: 1100px) {
    .masonry {
      column-count: 4;
    }
  }
  [data-cat-work] {
    break-inside: avoid;
  }
</style>
