---
import Layout from '@/layouts/Layout.astro';
import ArtistCard from '@/components/ui/ArtistCard.astro';
import { artists, artworks } from '@/data/gallery';

export const prerender = true;

const dirCount = `${artists.length} artists · ${artworks.length} works in the index`;
---

<Layout title="Artists — Verso">
  <main class="container page">
    <div class="eyebrow">Directory</div>
    <h1 class="h-display page__h1">Artists</h1>
    <p class="page__lede">{dirCount}</p>
    <div class="grid">
      {artists.map((a) => <ArtistCard artist={a} />)}
    </div>
  </main>
</Layout>

<style>
  .page {
    padding: clamp(40px, 6vw, 80px) 0;
  }
  .page__h1 {
    font-size: clamp(34px, 5.5vw, 74px);
    margin: 0.18em 0 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .page__lede {
    color: var(--muted);
    font-size: 16px;
    margin-top: 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: clamp(28px, 3vw, 46px);
    margin-top: 40px;
  }
</style>
