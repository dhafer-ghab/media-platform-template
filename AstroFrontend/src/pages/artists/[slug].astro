---
import Layout from '@/layouts/Layout.astro';
import WorkCard from '@/components/ui/WorkCard.astro';
import { artists, artworksByArtist } from '@/data/gallery';

export const prerender = true;

export function getStaticPaths() {
  return artists.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const artist = artists.find((a) => a.slug === slug);
if (!artist) {
  return Astro.redirect('/artists');
}

const works = artworksByArtist(artist.id);
const tagSet = [...new Set(works.flatMap((w) => w.tags))];
---

<Layout title={`${artist.name} — Verso`} description={artist.bio}>
  <main>
    <section class="container artist-head">
      <a class="back-link" href="/artists">← All artists</a>
      <div class="artist-head__grid">
        <div>
          <h1 class="h-display artist-head__h1">{artist.name}</h1>
          <div class="artist-head__loc">{artist.location}</div>
          <div class="artist-head__disc">{artist.disciplines} — Working since {artist.since}</div>
          <div class="artist-head__row">
            <button
              class="btn"
              data-follow-toggle
              data-artist-id={artist.id}
              data-label-follow="+ Follow"
              data-label-following="Following"
            >+ Follow</button>
            <span class="artist-head__count">{works.length} works in the index</span>
          </div>
        </div>
        <div>
          <p class="artist-head__bio">{artist.bio}</p>
          <div class="artist-head__tags">
            {tagSet.map((t) => <a class="tag-pill" href={`/tags/${encodeURIComponent(t.toLowerCase())}`}>{t}</a>)}
          </div>
        </div>
      </div>
    </section>

    <section class="container artist-works">
      <div class="masonry">
        {works.map((w) => <WorkCard work={w} variant="masonry" subline={w.category} />)}
      </div>
    </section>
  </main>
</Layout>

<style>
  .artist-head {
    padding: clamp(36px, 5vw, 72px) 0 0;
  }
  .artist-head__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(24px, 4vw, 64px);
    margin-top: 24px;
    align-items: start;
  }
  .artist-head__h1 {
    font-size: clamp(36px, 6vw, 82px);
    letter-spacing: -0.025em;
    line-height: 0.98;
  }
  .artist-head__loc {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 16px;
  }
  .artist-head__disc {
    font-size: 14px;
    color: var(--muted);
    margin-top: 6px;
  }
  .artist-head__row {
    display: flex;
    gap: 14px;
    margin-top: 26px;
    align-items: center;
    flex-wrap: wrap;
  }
  .artist-head__count {
    font-size: 13px;
    color: var(--faint);
  }
  .artist-head__bio {
    font-family: 'Spectral', serif;
    font-size: clamp(18px, 1.9vw, 24px);
    line-height: 1.5;
    color: var(--text-3);
    margin: 0;
    text-wrap: pretty;
  }
  .artist-head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 24px;
  }

  .btn {
    cursor: pointer;
    font-family: 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 13px 24px;
    white-space: nowrap;
    transition: all 0.2s;
    background: var(--ink);
    border: 1px solid var(--ink);
    color: var(--on-ink);
  }
  .btn[data-following='1'] {
    background: transparent;
    color: var(--text-2);
    border-color: var(--border);
  }

  .artist-works {
    padding: clamp(40px, 5vw, 72px) 0 0;
  }
  .artist-works .masonry {
    border-top: 1px solid var(--border-soft);
    padding-top: 30px;
    column-count: 2;
    column-gap: 30px;
  }
  @media (min-width: 700px) {
    .artist-works .masonry {
      column-count: 3;
    }
  }
  @media (min-width: 1100px) {
    .artist-works .masonry {
      column-count: 4;
    }
  }
</style>
