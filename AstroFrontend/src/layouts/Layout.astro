---
import Header from '@/components/ui/Header.astro';
import Footer from '@/components/ui/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  initialQ?: string;
  robots?: string;
  canonical?: string;
}

const {
  title = 'Verso — An index of contemporary visual artists',
  description = 'Verso is a slow place to discover painters, photographers, printmakers and digital artists from around the world — one work at a time.',
  initialQ = '',
  robots = 'index,follow',
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f5f2ec" data-theme-color />
    <script is:inline data-theme-script>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('verso:theme');
        } catch {
          // Fall back to the operating-system preference.
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document.querySelector('[data-theme-color]')?.setAttribute(
          'content',
          theme === 'dark' ? '#14110e' : '#f5f2ec',
        );
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Archivo:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <Header initialQ={initialQ} />
      <slot />
      <Footer />
    </div>

    <style is:global>
      :root {
        --bg: #f5f2ec;
        --surface: #efebe2;
        --ink: #1a1714;
        --on-ink: #f5f2ec;
        --text: #1a1714;
        --text-2: #3a362f;
        --text-3: #4a463f;
        --muted: #6b655c;
        --faint: #9a9286;
        --border: #c9c2b4;
        --border-soft: #e2dccf;
        --accent: #c8482b;
        --header-bg: rgba(245, 242, 236, 0.9);
        --hairline: rgba(0, 0, 0, 0.07);
        --chip-bg: rgba(26, 23, 20, 0.06);
        --shadow: rgba(26, 23, 20, 0.35);
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14110e;
          --surface: #1f1b16;
          --ink: #f0ebe0;
          --on-ink: #14110e;
          --text: #ece6da;
          --text-2: #d2c9b8;
          --text-3: #bdb29c;
          --muted: #9a917f;
          --faint: #766d5e;
          --border: #3a342a;
          --border-soft: #28231d;
          --accent: #e87a5d;
          --header-bg: rgba(20, 17, 14, 0.85);
          --hairline: rgba(255, 255, 255, 0.06);
          --chip-bg: rgba(240, 235, 224, 0.08);
          --shadow: rgba(0, 0, 0, 0.6);
          color-scheme: dark;
        }
      }
      :root[data-theme='light'] {
        --bg: #f5f2ec;
        --surface: #efebe2;
        --ink: #1a1714;
        --on-ink: #f5f2ec;
        --text: #1a1714;
        --text-2: #3a362f;
        --text-3: #4a463f;
        --muted: #6b655c;
        --faint: #9a9286;
        --border: #c9c2b4;
        --border-soft: #e2dccf;
        --accent: #c8482b;
        --header-bg: rgba(245, 242, 236, 0.9);
        --hairline: rgba(0, 0, 0, 0.07);
        --chip-bg: rgba(26, 23, 20, 0.06);
        --shadow: rgba(26, 23, 20, 0.35);
        color-scheme: light;
      }
      :root[data-theme='dark'] {
        --bg: #0e1116;           /* deep, slightly blue-black background */
        --surface: #181c23;      /* lifted surface – still cool but not flat */
        --ink: #f1f3f7;          /* crisp near-white for primary text */
        --on-ink: #0e1116;       /* ink used as background for buttons etc. */
        --text: #e4e8ee;         /* main body text – softly cool off-white */
        --text-2: #bac1cc;       /* secondary text – muted but readable */
        --text-3: #8f98a4;       /* tertiary text / hints */
        --muted: #6b7583;        /* muted elements (dates, meta) */
        --faint: #47515c;        /* disabled / very subtle elements */
        --border: #2b3039;       /* visible borders – cool dark grey */
        --border-soft: #20252c;  /* softer separators */
        --accent: #5b8def;       /* modern electric blue – clean and vibrant */
        --header-bg: rgba(14, 17, 22, 0.88);
        --hairline: rgba(255, 255, 255, 0.06);
        --chip-bg: rgba(241, 243, 247, 0.07);
        --shadow: rgba(0, 0, 0, 0.7);
        color-scheme: dark;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Archivo', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        transition: background-color 0.25s ease, color 0.25s ease;
      }
      ::selection {
        background: var(--ink);
        color: var(--on-ink);
      }
      input::placeholder {
        color: var(--faint);
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button {
        font-family: inherit;
      }

      .page {
        min-height: 100vh;
        background: var(--bg);
        color: var(--text);
      }

      .container {
        width: min(1320px, 92vw);
        margin: 0 auto;
      }

      .eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .h-display {
        font-family: 'Spectral', serif;
        font-weight: 300;
        line-height: 0.98;
        letter-spacing: -0.022em;
        margin: 0;
      }

      .h-section {
        font-family: 'Spectral', serif;
        font-weight: 400;
        margin: 0;
      }

      .btn {
        cursor: pointer;
        font-family: 'Archivo', system-ui, sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 15px 26px;
        white-space: nowrap;
        border: none;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .btn-primary {
        background: var(--ink);
        color: var(--on-ink);
      }
      .btn-ghost {
        background: transparent;
        border: 1px solid var(--ink);
        color: var(--text);
      }
      .btn-sm {
        padding: 13px 24px;
      }
      .btn:hover {
        opacity: 0.92;
      }

      .chip {
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 9px 16px;
        border-radius: 999px;
        transition: all 0.2s;
        background: transparent;
        color: var(--text-2);
        border: 1px solid var(--border);
        display: inline-block;
      }
      .chip.is-active {
        background: var(--ink);
        color: var(--on-ink);
        border-color: var(--ink);
      }
      .chip:hover {
        border-color: var(--ink);
      }

      .tag-pill {
        cursor: pointer;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 7px 13px;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--text-2);
        display: inline-block;
        transition: all 0.2s;
      }
      .tag-pill:hover {
        border-color: var(--ink);
        color: var(--text);
      }

      .crumbs {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: var(--faint);
      }
      .crumbs a {
        cursor: pointer;
      }
      .crumbs a:hover {
        color: var(--text);
      }
      .crumb-sep {
        margin: 0 8px;
      }

      .back-link {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        cursor: pointer;
        transition: color 0.2s;
        display: inline-block;
      }
      .back-link:hover {
        color: var(--accent);
      }

      @keyframes fade {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </body>
</html>
