---
import { slugify, type Artwork } from '@/data/gallery';

interface Props {
  work: Artwork;
  showArtist?: boolean;
  variant?: 'default' | 'masonry' | 'compact' | 'spotlight' | 'pin';
  subline?: string;
  maxTags?: number;
}

const { work, showArtist = true, variant = 'default', subline, maxTags = 2 } = Astro.props;
const subText = subline ?? (showArtist ? work.artistName : '');
const visibleTags = work.tags.slice(0, maxTags);
---

{
  variant === 'pin' ? (
    <article class="work-pin">
      <a class="work-pin__art-link" href={`/works/${work.slug}`} aria-label={work.title}>
        <div class="work-pin__art" style={`background:${work.bg};aspect-ratio:${work.ar};`} />
      </a>
      <div class="work-pin__body">
        <a class="work-pin__title" href={`/works/${work.slug}`}>{work.title}</a>
        <div class="work-pin__meta">
          <a class="work-pin__chip work-pin__chip--artist" href={`/artists/${work.artistSlug}`}>
            {work.artistName}
          </a>
          <span class="work-pin__year">{work.year}</span>
        </div>
        <div class="work-pin__tags">
          <a class="work-pin__chip work-pin__chip--cat" href={`/categories/${work.categorySlug}`}>
            {work.category}
          </a>
          {visibleTags.map((t) => (
            <a class="work-pin__chip" href={`/tags/${slugify(t)}`}>
              #{t}
            </a>
          ))}
        </div>
      </div>
    </article>
  ) : (
    <a class={`work-card work-card--${variant}`} href={`/works/${work.slug}`}>
      <div class="work-card__art" style={`background:${work.bg};aspect-ratio:${work.ar};`} />
      {variant === 'spotlight' ? (
        <div class="work-card__title work-card__title--spotlight">{work.title}</div>
      ) : (
        <div class="work-card__meta">
          <div class="work-card__meta-l">
            <div class="work-card__title">{work.title}</div>
            {subText && <div class="work-card__sub">{subText}</div>}
          </div>
          <div class="work-card__year">{work.year}</div>
        </div>
      )}
    </a>
  )
}

<style>
  .work-card {
    cursor: pointer;
    display: block;
    transition: opacity 0.25s;
  }
  .work-card:hover {
    opacity: 0.86;
  }
  .work-card--masonry {
    break-inside: avoid;
    margin: 0 0 30px;
  }
  .work-card__art {
    width: 100%;
    border: 1px solid var(--hairline);
  }
  .work-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    margin-top: 12px;
  }
  .work-card__meta-l {
    min-width: 0;
  }
  .work-card__title {
    font-family: 'Spectral', serif;
    font-style: italic;
    font-size: 17px;
    line-height: 1.2;
  }
  .work-card--compact .work-card__title {
    font-size: 16px;
  }
  .work-card__title--spotlight {
    font-family: 'Spectral', serif;
    font-style: italic;
    font-size: 14px;
    line-height: 1.25;
    margin-top: 9px;
  }
  .work-card__sub {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 5px;
  }
  .work-card__year {
    font-size: 11px;
    font-weight: 500;
    color: var(--faint);
    white-space: nowrap;
  }

  /* Pinterest-style pin variant */
  .work-pin {
    break-inside: avoid;
    margin: 0 0 22px;
    display: block;
    border-radius: 18px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .work-pin:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -28px var(--shadow);
  }
  .work-pin__art-link {
    display: block;
    border-radius: 18px;
    overflow: hidden;
    color: inherit;
  }
  .work-pin__art {
    width: 100%;
    border-radius: 18px;
    transition: transform 0.4s ease;
  }
  .work-pin__art-link:hover .work-pin__art {
    transform: scale(1.02);
  }
  .work-pin__body {
    padding: 14px 4px 6px;
  }
  .work-pin__title {
    display: block;
    font-family: 'Spectral', serif;
    font-style: italic;
    font-size: 18px;
    line-height: 1.25;
    color: var(--text);
    transition: color 0.2s;
  }
  .work-pin__title:hover {
    color: var(--accent);
  }
  .work-pin__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
  }
  .work-pin__year {
    font-size: 11px;
    font-weight: 500;
    color: var(--faint);
    letter-spacing: 0.04em;
  }
  .work-pin__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .work-pin__chip {
    cursor: pointer;
    font-family: 'Archivo', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--text-2);
    transition: background 0.18s, color 0.18s;
    line-height: 1;
    white-space: nowrap;
  }
  .work-pin__chip:hover {
    background: var(--ink);
    color: var(--on-ink);
  }
  .work-pin__chip--artist {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: 11px;
  }
  .work-pin__chip--artist:hover {
    background: transparent;
    color: var(--accent);
  }
  .work-pin__chip--cat {
    background: var(--ink);
    color: var(--on-ink);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .work-pin__chip--cat:hover {
    background: var(--accent);
    color: #f5f2ec;
  }
</style>
