---
interface Props {
  initialQ?: string;
}
const { initialQ = '' } = Astro.props;
const pathname = Astro.url.pathname;
const requestedSort = Astro.url.searchParams.get('sort');
const activeSort = requestedSort === 'popular' || requestedSort === 'oldest' || requestedSort === 'title'
  ? requestedSort
  : 'newest';
const sortLabels = {
  newest: 'Newest first',
  popular: 'Most viewed',
  oldest: 'Oldest first',
  title: 'Title A–Z',
};
const navItems = [
  { href: '/explore', label: 'Explore', activePrefixes: ['/explore'] },
  { href: '/artists', label: 'Artists', activePrefixes: ['/artists'] },
  { href: '/categories', label: 'Categories', activePrefixes: ['/categories'] },
  { href: '/tags', label: 'Tags', activePrefixes: ['/tag', '/tags'] },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">VERSO</a>
    <nav class="nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={item.activePrefixes.some((prefix) => pathname.startsWith(prefix)) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <form class="search" role="search" action="/search" method="get" data-search-form>
      <label class="search__field">
        <span class="sr-only">Keyword</span>
        <svg class="search__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.3-4.3"></path>
        </svg>
        <input
          type="search"
          name="q"
          value={initialQ}
          placeholder="Search the index"
          autocomplete="off"
          required
        />
      </label>

      <details class="filter-menu">
        <summary
          aria-label="Filter and sort"
          title="Filter and sort"
          class:list={{ 'is-active': activeSort !== 'newest' }}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h10M18 7h2M4 17h2M10 17h10"></path>
            <circle cx="16" cy="7" r="2"></circle>
            <circle cx="8" cy="17" r="2"></circle>
          </svg>
          <span class="filter-menu__label">Filter</span>
          <span class="filter-menu__indicator" aria-hidden="true"></span>
        </summary>

        <div class="filter-menu__panel">
          <div class="filter-menu__head">
            <span>Order results</span>
            <strong>{sortLabels[activeSort]}</strong>
          </div>
          <fieldset>
            <legend class="sr-only">Sort search results</legend>
            {Object.entries(sortLabels).map(([value, label]) => (
              <label class="sort-option">
                <input type="radio" name="sort" value={value} checked={activeSort === value} />
                <span>{label}</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12l4 4L19 6"></path>
                </svg>
              </label>
            ))}
          </fieldset>
          <button type="submit" class="filter-menu__apply">View results <span>→</span></button>
        </div>
      </details>
    </form>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Switch to dark mode"
      aria-pressed="false"
      title="Switch to dark mode"
    >
      <svg class="theme-toggle__icon theme-toggle__icon--sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
      </svg>
    </button>
  </div>
</header>

<script is:inline data-theme-script>
  (() => {
    const storageKey = 'verso:theme';
    const root = document.documentElement;
    const buttons = document.querySelectorAll('[data-theme-toggle]');

    const savedTheme = () => {
      try {
        const value = localStorage.getItem(storageKey);
        return value === 'light' || value === 'dark' ? value : null;
      } catch {
        return null;
      }
    };

    const updateControls = () => {
      const isDark = root.dataset.theme === 'dark';
      const label = isDark ? 'Switch to light mode' : 'Switch to dark mode';

      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(isDark));
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      });
    };

    const applyTheme = (theme, persist = true) => {
      root.dataset.theme = theme;
      document.querySelector('[data-theme-color]')?.setAttribute(
        'content',
        theme === 'dark' ? '#14110e' : '#f5f2ec',
      );
      if (persist) {
        try {
          localStorage.setItem(storageKey, theme);
        } catch {
          // Storage may be unavailable in privacy-restricted contexts.
        }
      }
      updateControls();
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    });

    updateControls();

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
      if (!savedTheme()) applyTheme(event.matches ? 'dark' : 'light', false);
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-soft);
  }
  .site-header__inner {
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
    padding: 11px 0;
  }
  .brand {
    font-family: 'Spectral', serif;
    font-weight: 600;
    font-size: 23px;
    letter-spacing: 0.03em;
    color: var(--text);
  }
  .nav {
    display: flex;
    gap: 22px;
    align-items: center;
  }
  .nav a {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--text);
    transition: color 0.2s;
  }
  .nav a:hover {
    color: var(--accent);
  }
  .nav a[aria-current='page'] {
    color: var(--accent);
  }
  .search {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 180px;
    flex: 0 1 360px;
    color: var(--muted);
    position: relative;
  }
  .search__field {
    align-items: center;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex: 1 1 auto;
    gap: 9px;
    min-width: 0;
    padding: 7px 2px;
    transition: border-color 0.2s;
  }
  .search__field:focus-within {
    border-color: var(--accent);
  }
  .search input {
    border: none;
    background: transparent;
    outline: none;
    font-size: 14px;
    font-family: 'Archivo', system-ui, sans-serif;
    color: var(--text);
    min-width: 0;
    width: 100%;
  }
  .search__icon {
    flex-shrink: 0;
  }
  .sr-only {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
  .filter-menu { flex: 0 0 auto; position: relative; }
  .filter-menu summary {
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-2);
    cursor: pointer;
    display: inline-flex;
    gap: 7px;
    height: 38px;
    justify-content: center;
    list-style: none;
    padding: 0 13px;
    position: relative;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .filter-menu summary::-webkit-details-marker { display: none; }
  .filter-menu summary:hover,
  .filter-menu[open] summary {
    background: var(--chip-bg);
    border-color: var(--ink);
    color: var(--accent);
  }
  .filter-menu summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .filter-menu__label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .filter-menu__indicator {
    background: var(--accent);
    border: 2px solid var(--bg);
    border-radius: 999px;
    display: none;
    height: 8px;
    position: absolute;
    right: -1px;
    top: -1px;
    width: 8px;
  }
  .filter-menu summary.is-active .filter-menu__indicator { display: block; }
  .filter-menu__panel {
    background: var(--bg);
    border: 1px solid var(--border);
    box-shadow: 0 18px 50px var(--shadow);
    color: var(--text);
    min-width: 270px;
    padding: 22px;
    position: absolute;
    right: 0;
    top: calc(100% + 13px);
    z-index: 60;
  }
  .filter-menu__panel::before {
    background: var(--bg);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
    content: '';
    height: 10px;
    position: absolute;
    right: 24px;
    top: -6px;
    transform: rotate(45deg);
    width: 10px;
  }
  .filter-menu__head {
    border-bottom: 1px solid var(--border-soft);
    display: grid;
    gap: 6px;
    padding-bottom: 16px;
  }
  .filter-menu__head span {
    color: var(--muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .filter-menu__head strong {
    font-family: 'Spectral', serif;
    font-size: 21px;
    font-style: italic;
    font-weight: 400;
  }
  .filter-menu fieldset {
    border: 0;
    display: grid;
    margin: 10px 0 16px;
    padding: 0;
  }
  .sort-option {
    align-items: center;
    cursor: pointer;
    display: grid;
    font-size: 12px;
    gap: 10px;
    grid-template-columns: auto 1fr auto;
    padding: 10px 2px;
  }
  .sort-option input {
    accent-color: var(--accent);
    height: 14px;
    margin: 0;
    width: 14px;
  }
  .sort-option svg { color: var(--accent); opacity: 0; }
  .sort-option:has(input:checked) { color: var(--accent); }
  .sort-option:has(input:checked) svg { opacity: 1; }
  .filter-menu__apply {
    align-items: center;
    background: var(--ink);
    border: 0;
    color: var(--on-ink);
    cursor: pointer;
    display: flex;
    font-size: 10px;
    font-weight: 600;
    justify-content: space-between;
    letter-spacing: 0.12em;
    min-height: 44px;
    padding: 0 16px;
    text-transform: uppercase;
    width: 100%;
  }
  .filter-menu__apply:hover { background: var(--accent); }
  .theme-toggle {
    align-items: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    cursor: pointer;
    display: inline-flex;
    flex: 0 0 38px;
    height: 38px;
    justify-content: center;
    padding: 0;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
    width: 38px;
  }
  .theme-toggle:hover {
    background: var(--chip-bg);
    border-color: var(--ink);
    color: var(--accent);
    transform: rotate(8deg);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .theme-toggle__icon--sun { display: none; }
  .theme-toggle__icon--moon { display: block; }
  :global([data-theme='dark']) .theme-toggle__icon--sun { display: block; }
  :global([data-theme='dark']) .theme-toggle__icon--moon { display: none; }

  @media (max-width: 680px) {
    .site-header__inner { gap: 10px; }
    .brand { font-size: 20px; }
    .nav { gap: 14px; order: 3; width: 100%; }
    .search { flex: 1 1 150px; min-width: 0; }
    .filter-menu summary { padding: 0; width: 38px; }
    .filter-menu__label { display: none; }
    .filter-menu__panel {
      position: fixed;
      right: 4vw;
      top: 72px;
      width: min(330px, 92vw);
    }
    .filter-menu__panel::before { display: none; }
    .theme-toggle { flex-basis: 36px; height: 36px; width: 36px; }
  }

</style>
