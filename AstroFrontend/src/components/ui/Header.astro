---
interface Props {
  initialQ?: string;
}
const { initialQ = '' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const discoverActive = currentPath === '/';
const exploreActive = currentPath === '/explore';
const artistsActive = currentPath === '/artists' || currentPath.startsWith('/artists/');
const categoriesActive = currentPath === '/categories' || currentPath.startsWith('/categories/');
const tagsActive = currentPath === '/tags' || currentPath.startsWith('/tags/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">VERSO</a>
    <nav class="nav" aria-label="Primary navigation">
      <a class:list={{ 'is-active': discoverActive }} href="/" aria-current={discoverActive ? 'page' : undefined}>Discover</a>
      <a class:list={{ 'is-active': exploreActive }} href="/explore" aria-current={exploreActive ? 'page' : undefined}>Explore</a>
      <a class:list={{ 'is-active': artistsActive }} href="/artists" aria-current={currentPath === '/artists' ? 'page' : undefined}>Artists</a>
      <a class:list={{ 'is-active': categoriesActive }} href="/categories" aria-current={currentPath === '/categories' ? 'page' : undefined}>Categories</a>
      <a class:list={{ 'is-active': tagsActive }} href="/tags" aria-current={currentPath === '/tags' ? 'page' : undefined}>Tags</a>
      <a href="/login" id="auth-link">Login</a>
    </nav>
    <form class="search" role="search" action="/search" method="get" data-search-form>
      <svg class="search__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M21 21l-4.3-4.3"></path>
      </svg>
      <label class="search__label" for="site-search">Search artists, works, and tags</label>
      <input
        id="site-search"
        type="search"
        name="q"
        value={initialQ}
        placeholder="Search artists, works, tags"
        autocomplete="off"
        data-header-search
      />
    </form>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Toggle dark mode"
      title="Toggle theme"
    >
      <svg class="theme-toggle__icon theme-toggle__icon--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="M4.93 4.93l1.41 1.41"></path>
        <path d="M17.66 17.66l1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="M4.93 19.07l1.41-1.41"></path>
        <path d="M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  function setTheme(theme: 'light' | 'dark', persist = true): void {
    document.documentElement.setAttribute('data-theme', theme);
    if (persist) {
      try {
        localStorage.setItem('verso:theme', theme);
      } catch {
        /* ignore */
      }
    }
    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      .forEach((btn) => {
        const isDark = theme === 'dark';
        btn.setAttribute('aria-pressed', String(isDark));
        btn.setAttribute(
          'aria-label',
          isDark ? 'Switch to light mode' : 'Switch to dark mode',
        );
      });
  }

  const current =
    (document.documentElement.getAttribute('data-theme') as 'light' | 'dark') ||
    'light';
  setTheme(current, false);

  document
    .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
    .forEach((btn) => {
      btn.addEventListener('click', () => {
        const next =
          document.documentElement.getAttribute('data-theme') === 'dark'
            ? 'light'
            : 'dark';
        setTheme(next);
      });
    });

  const media = window.matchMedia('(prefers-color-scheme: dark)');
  media.addEventListener('change', (e) => {
    try {
      if (localStorage.getItem('verso:theme')) return;
    } catch {
      /* ignore */
    }
    setTheme(e.matches ? 'dark' : 'light', false);
  });

  document.addEventListener('DOMContentLoaded', () => {
    const authLink = document.getElementById('auth-link') as HTMLAnchorElement | null;     
    const token = localStorage.getItem('authToken');

    if (authLink && token) {
      authLink.textContent = 'Logout';
      authLink.href = '#';
      authLink.addEventListener('click', (e) => {
        e.preventDefault();
        localStorage.removeItem('authToken');
        window.location.href = '/';
      });
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-soft);
  }
  .site-header__inner {
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
    padding: 11px 0;
  }
  .brand {
    font-family: 'Spectral', serif;
    font-weight: 600;
    font-size: 23px;
    letter-spacing: 0.03em;
    color: var(--text);
  }
  .nav {
    display: flex;
    gap: 22px;
    align-items: center;
  }
  .nav a {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--text);
    transition: color 0.2s;
  }
  .nav a:hover {
    color: var(--accent);
  }
  .nav a.is-active {
    color: var(--accent);
  }
  .search {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 9px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 5px;
    min-width: 180px;
    flex: 0 1 300px;
    color: var(--muted);
  }
  .search input {
    border: none;
    background: transparent;
    outline: none;
    font-size: 14px;
    font-family: 'Archivo', system-ui, sans-serif;
    color: var(--text);
    width: 100%;
  }
  .search__icon {
    flex-shrink: 0;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .theme-toggle:hover {
    border-color: var(--ink);
    color: var(--accent);
  }
  .theme-toggle__icon {
    display: block;
  }
  .theme-toggle__icon--moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle__icon--sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle__icon--moon {
    display: block;
  }
  .search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 1px 0 var(--accent);
  }
  .search__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 760px) {
    .site-header__inner {
      gap: 16px;
    }
    .nav {
      order: 3;
      width: 100%;
      gap: 20px;
      overflow-x: auto;
      padding-bottom: 2px;
    }
    .search {
      min-width: 0;
    }
  }
</style>
