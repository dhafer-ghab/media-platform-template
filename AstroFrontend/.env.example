# Base URL of the .NET backend API
# PUBLIC_ prefix means this value is exposed to the browser bundle
PUBLIC_API_BASE_URL=https://localhost:7021

# Internal Posts API URL used only by Astro's server-rendered discovery pages.
# Do not add PUBLIC_ here: browsers do not need direct access to this endpoint.
POSTS_API_URL=https://localhost:7021

# Absolute public origin of this site.
# Used for canonical URLs, og:url and the sitemap. Must be the real production
# origin in production — a wrong value silently de-indexes the site.
PUBLIC_SITE_URL=http://localhost:4321

# Address used by artwork inquiry links.
PUBLIC_INQUIRY_EMAIL=gallery@example.com

# Origin serving transformed images. Leave unset to render gradient
# placeholders — the app works either way, no code change required.
# PUBLIC_IMAGE_BASE_URL=https://cdn.example.com

# Origin serving video streams and poster frames. Leave unset to render
# poster placeholders with a link to the post page instead of a player.
# PUBLIC_VIDEO_BASE_URL=https://videodelivery.example.com
